# Copy to .env and fill in. .env is git-ignored; never commit real values.
# All settings are optional — the demo loads and runs without any of them.

# --------------------------------------------------- selecting an account
# .env is the base layer. A SECOND env file can be layered over it, and its
# values win:
#
#   .venv/bin/python -m translog_quote.interface.web  --live --env-file .env.<name>
#   .venv/bin/python -m translog_quote.interface.demo --env-file .env.<name> gmail-auth
#   TRANSLOG_ENV_FILE=.env.<name> .venv/bin/python -m translog_quote.interface.demo gmail-quote
#
# That is how a dedicated demo mailbox gets a configuration path of its own.
# The account file names one mailbox and its own OAuth TOKEN paths; everything
# it does not mention — the OpenRouter key above all — is inherited from .env
# and is not written twice. Switching accounts is selecting a different file,
# so the previous account's configuration and tokens survive the switch:
#
#   TRANSLOG_GMAIL__TEST_ADDRESS=demo-account@example.com
#   TRANSLOG_GMAIL__SENDER_ADDRESS=demo-account@example.com
#   TRANSLOG_GMAIL__APPROVER_ADDRESS=demo-account@example.com
#   TRANSLOG_GMAIL__TOKEN_PATH=.secrets/<name>/gmail_token.json
#   TRANSLOG_GMAIL__SEND_TOKEN_PATH=.secrets/<name>/gmail_send_token.json
#
# Separate token paths matter: a token is bound to an account, so consenting
# as the new account must not overwrite the old account's token. The OAuth
# CLIENT file identifies the Google Cloud application rather than the mailbox
# and is normally shared, so it is not duplicated per account.
#
# A --env-file that does not exist is an error, never a silent fall-back to
# .env — falling back would run the demo against the other account while the
# operator believed they had switched.

# ---------------------------------------------------------------- environment
TRANSLOG_ENVIRONMENT=demo          # demo | development | production
TRANSLOG_LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR

# ----------------------------------------------------------------- OpenRouter
# Used by the extraction adapter (Phase 5). Not read before then.
# Required for live extraction. Without it the extraction adapter refuses to
# build, and the offline test suite still passes.
TRANSLOG_OPENROUTER__API_KEY=
TRANSLOG_OPENROUTER__BASE_URL=https://openrouter.ai/api/v1
# Qwen 3.7 Flash. Verified against OpenRouter's live model list (AMB-2 resolved).
# Note the DOUBLE underscore: nested settings use "__" as the delimiter.
TRANSLOG_OPENROUTER__MODEL=qwen/qwen3.7-flash
TRANSLOG_OPENROUTER__TIMEOUT_SECONDS=60
TRANSLOG_OPENROUTER__MAX_RETRIES=2

# ------------------------------------------------------------------ WebCargo
# mock    -> MockWebCargoAdapter, fixture rate sets (the demo default)
# demo    -> DemoRateProvider, shipment-priced simulated rates (flagged simulated)
# browser -> the real WebCargo provider: a persistent, authenticated Chromium
#            session driven by the ONE browser worker. It runs ONLY inside that
#            worker process; every other process asked for browser mode refuses
#            and enqueues a job through the async rate-search API instead.
TRANSLOG_WEBCARGO__MODE=mock
# The WebCargo app URL an operator signs in to. No endpoint is written in the
# repo, so browser mode refuses to start without it. USERNAME/PASSWORD are never
# used to log in automatically — sign-in (incl. MFA/CAPTCHA) is a manual,
# one-time operator step; see docs/webcargo-operator-auth.md.
TRANSLOG_WEBCARGO__BASE_URL=
TRANSLOG_WEBCARGO__USERNAME=
TRANSLOG_WEBCARGO__PASSWORD=
# Persistent Chromium profile holding the authenticated WebCargo session, reused
# across jobs and worker restarts. Must live on durable storage — an ephemeral
# filesystem wipes the session and forces re-authentication. Only the browser
# worker reads it.
TRANSLOG_WEBCARGO__USER_DATA_DIR=.browser/webcargo-profile

# ------------------------------------------------- rate-search queue (Redis/RQ)
# Joins the async rate-search API to the ONE browser worker. Both sides MUST
# point at the same Redis instance and queue name. A managed rediss:// (TLS)
# endpoint is expected in any real deployment; the URL carries a credential, so
# it belongs in git-ignored local config (e.g. .env.worker on the Fedora worker
# box) or the host's secret store — NEVER in this file or any committed file:
#
#   TRANSLOG_QUEUE__REDIS_URL=rediss://<user>:<password>@<host>:<port>/0
#
# One worker per queue is enforced by a Redis lock; a second worker refuses
# loudly rather than run concurrent WebCargo automation.
TRANSLOG_QUEUE__REDIS_URL=redis://localhost:6379/0

# --------------------------------------------------------------- Gmail (test)
# Phase 10.3 — receive-only test against ONE personal test mailbox.
# The company mailbox is NOT connected. Used only by the explicit
# `gmail-test` command; the fixture email source stays the default everywhere.
#
# The mailbox address is never hardcoded — set it here:
TRANSLOG_GMAIL__TEST_ADDRESS=
# OAuth files live under .secrets/ (git-ignored). No passwords, ever:
#   client secret: downloaded from Google Cloud console (Desktop-app OAuth client)
#   token:         written by `python -m translog_quote.interface.demo gmail-auth`
TRANSLOG_GMAIL__CLIENT_SECRET_PATH=.secrets/gmail_client_secret.json
TRANSLOG_GMAIL__TOKEN_PATH=.secrets/gmail_token.json
# Narrow selection for the one-email test: inbox only, newest message only.
# For the gmail-quote demo, raise MAX_RESULTS so a conversation (enquiry +
# reply) fits, and exclude Translog's own internal approval mail — it lands in
# this same inbox and is not a client enquiry:
#   TRANSLOG_GMAIL__QUERY=in:inbox -subject:"[TRANSLOG INTERNAL]"
#   TRANSLOG_GMAIL__MAX_RESULTS=5
# (The command filters those messages out itself as well; the query just keeps
# them from consuming the read budget.)
TRANSLOG_GMAIL__QUERY=in:inbox
TRANSLOG_GMAIL__MAX_RESULTS=1

# --- Gmail OUTBOUND (Phase 11 — sending) --------------------------------------
# A SECOND, SEPARATE credential. The token above holds gmail.readonly and
# cannot send; the token below holds gmail.send and cannot read. They are
# granted in two consent runs into two files, on purpose.
#
#   .venv/bin/python -m translog_quote.interface.demo gmail-auth-send
#
# Off by default. Nothing in this project sends real email until this is true:
TRANSLOG_GMAIL__SEND_ENABLED=false
TRANSLOG_GMAIL__SEND_TOKEN_PATH=.secrets/gmail_send_token.json
# The mailbox quotations are sent FROM. Written into the From header, which
# Gmail validates against the authenticated account. Defaults to TEST_ADDRESS.
TRANSLOG_GMAIL__SENDER_ADDRESS=
# The INTERNAL mailbox the quotation review packet goes to for human approval.
# Never a client address — the review lists excluded carriers and runner-up
# rates, which is internal commercial detail. Required by `gmail-quote`.
TRANSLOG_GMAIL__APPROVER_ADDRESS=

# The Gmail query excludes Translog's own internal approval mail and nothing
# else — ordinary inbox messages are retrieved normally:
#   TRANSLOG_GMAIL__QUERY=in:inbox -subject:"[TRANSLOG INTERNAL]"
#
# There is no subject or sender allowlist to maintain. Whether a message is a
# quotation enquiry is decided by the pipeline that already runs on it: a
# message extraction finds no shipment in is grouped separately in the UI and
# is never offered a clarification.

# ---------------------------------------------------------------------- demo
TRANSLOG_DEMO__FIXTURES_DIR=fixtures/scenarios
TRANSLOG_DEMO__OUTBOX_DIR=outbox
# Durable demo state, so a run that sends a clarification today and reads the
# client's reply tomorrow remembers what it already sent. Git-ignored.
# Clear it between rehearsals; never mid-run.
TRANSLOG_DEMO__STATE_DIR=runs/state
TRANSLOG_DEMO__DETERMINISTIC=true
