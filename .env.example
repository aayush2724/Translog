# Copy to .env and fill in. .env is git-ignored; never commit real values.
# All settings are optional — the demo loads and runs without any of them.

# ---------------------------------------------------------------- environment
TRANSLOG_ENVIRONMENT=demo          # demo | development | production
TRANSLOG_LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR

# ----------------------------------------------------------------- OpenRouter
# Used by the extraction adapter (Phase 5). Not read before then.
TRANSLOG_OPENROUTER__API_KEY=
TRANSLOG_OPENROUTER__BASE_URL=https://openrouter.ai/api/v1
# AMB-2 is unresolved: the brief names "Qwen 3.7 Flash", the specification names
# "Qwen Plus 0728", and neither is an OpenRouter model slug. Leave blank until the
# exact slug is confirmed against OpenRouter's live model list.
TRANSLOG_OPENROUTER__MODEL=
TRANSLOG_OPENROUTER__TIMEOUT_SECONDS=60
TRANSLOG_OPENROUTER__MAX_RETRIES=2

# ------------------------------------------------------------------ WebCargo
# mock  -> MockWebCargoAdapter, fixture rate sets (the demo default)
# real  -> RealWebCargoAdapter, which is a stub that raises. Blocked by AMB-1
#          (transit-time source unverified) and AMB-3 (carrier restriction rules).
TRANSLOG_WEBCARGO__MODE=mock
TRANSLOG_WEBCARGO__BASE_URL=
TRANSLOG_WEBCARGO__USERNAME=
TRANSLOG_WEBCARGO__PASSWORD=

# ---------------------------------------------------------------------- demo
TRANSLOG_DEMO__FIXTURES_DIR=fixtures/scenarios
TRANSLOG_DEMO__OUTBOX_DIR=outbox
TRANSLOG_DEMO__DETERMINISTIC=true
